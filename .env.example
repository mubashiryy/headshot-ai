# ─── Replicate ────────────────────────────────────────────────────────────────
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PhotoMaker model version — grab the latest hash from:
# https://replicate.com/tencentarc/photomaker
# Click "Use this model" → copy the version string
PHOTOMAKER_VERSION=cc35083c49be8e8d3c6a1aa1e76cf51d6e7b3745

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Create two prices in Stripe Dashboard → Products:
#   1. "HeadshotAI HD Download" — one-time $19.00
#   2. "HeadshotAI Pro" — recurring $12.00/month
# Then paste the price IDs here:
STRIPE_PRICE_ONE_TIME=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUBSCRIPTION=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — Stripe Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://your-domain.vercel.app/api/webhook
# Events to listen for: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App ──────────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
